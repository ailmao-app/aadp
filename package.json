{
  "name": "aadp",
  "version": "0.1.0",
  "description": "AI Application Discovery Protocol (AADP) — specification, schemas, validator, reference client and conformance suite",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./validator": {
      "types": "./dist/validator/index.d.ts",
      "import": "./dist/validator/index.js"
    },
    "./canonical-json": {
      "types": "./dist/canonical-json/index.d.ts",
      "import": "./dist/canonical-json/index.js"
    },
    "./schemas/*": "./schemas/v0.1/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "spec",
    "CHANGELOG.md",
    "README.md"
  ],
  "bin": {
    "aadp-validate": "./dist/validator/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "validate": "node --loader ts-node/esm src/validator/cli.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
