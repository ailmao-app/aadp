{
  "name": "ail-aadp",
  "version": "1.1.0",
  "description": "AI Application Discovery Protocol (AADP) — specification, schemas, validator, reference client and conformance suite",
  "keywords": [
    "aadp",
    "ai",
    "ai-agent",
    "application-discovery",
    "aeo",
    "geo",
    "protocol",
    "schema",
    "validator"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ailmao-app/aadp.git"
  },
  "homepage": "https://github.com/ailmao-app/aadp#readme",
  "bugs": {
    "url": "https://github.com/ailmao-app/aadp/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client/v0.1": {
      "types": "./dist/client/v0.1/index.d.ts",
      "import": "./dist/client/v0.1/index.js"
    },
    "./client/v1.0": {
      "types": "./dist/client/v1.0/index.d.ts",
      "import": "./dist/client/v1.0/index.js"
    },
    "./validator": {
      "types": "./dist/validator/index.d.ts",
      "import": "./dist/validator/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./scaffold": {
      "types": "./dist/scaffold/index.d.ts",
      "import": "./dist/scaffold/index.js"
    },
    "./canonical-json": {
      "types": "./dist/canonical-json/index.d.ts",
      "import": "./dist/canonical-json/index.js"
    },
    "./schemas/v0.1/*": "./schemas/v0.1/*",
    "./schemas/v1.0/*": "./schemas/v1.0/*",
    "./schemas/*": "./schemas/v0.1/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "spec",
    "examples",
    "scripts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "aadp-validate": "dist/validator/cli.js",
    "aadp-conformance": "dist/conformance/cli.js",
    "aadp": "dist/scaffold/cli.js"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "validate": "node dist/validator/cli.js",
    "conformance": "node dist/conformance/cli.js",
    "docs:check": "node scripts/check-doc-links.mjs",
    "check:iana-ipv6": "node scripts/check-iana-ipv6-allowlist.mjs",
    "check:release-consistency": "node scripts/check-release-consistency.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
