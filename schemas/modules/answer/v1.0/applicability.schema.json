{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aadp.dev/schemas/modules/answer/v1.0/applicability.schema.json",
  "title": "AADP Answer Module v1.0 — Applicability",
  "description": "Component schema (not a top-level module document kind). At least one field must be present (specification.md \"Applicability contract\"). Duplicate-token/value checks and the `valid_from < valid_until` ordering are pure semantic rules, not expressible here.",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "audiences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(general|[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]{0,63})$"
      }
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^([A-Z]{2}|[0-9]{3})$"
      }
    },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "notes": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
