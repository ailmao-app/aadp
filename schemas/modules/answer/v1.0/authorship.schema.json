{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aadp.dev/schemas/modules/answer/v1.0/authorship.schema.json",
  "title": "AADP Answer Module v1.0 — Authorship",
  "description": "Component schema (not a top-level module document kind). Tagged union discriminated by `kind`; the two branches are mutually exclusive and each object is closed (specification.md \"Authorship contract\").",
  "oneOf": [
    {
      "type": "object",
      "title": "source-authored",
      "required": ["kind", "author"],
      "properties": {
        "kind": { "const": "source-authored" },
        "author": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "generated-summary",
      "required": ["kind", "generator", "generated_at", "source_targets"],
      "properties": {
        "kind": { "const": "generated-summary" },
        "generator": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "generated_at": { "type": "string", "format": "date-time" },
        "source_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "answer-reference.schema.json" }
        },
        "reviewed_by": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
