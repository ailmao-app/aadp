{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aadp.dev/schemas/v0.1/sitemap-index.schema.json",
  "title": "AADP Sitemap Index v0.1",
  "type": "object",
  "required": ["aadp_version", "generated_at", "checksum", "sitemaps"],
  "properties": {
    "aadp_version": { "const": "0.1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sitemaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "url"],
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "url": { "type": "string", "format": "uri" },
          "count": { "type": "integer", "minimum": 0 }
        },
        "patternProperties": { "^x_[a-zA-Z0-9_]*$": {} },
        "additionalProperties": false
      }
    }
  },
  "patternProperties": {
    "^x_[a-zA-Z0-9_]*$": {}
  },
  "additionalProperties": false
}
